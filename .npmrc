# npm configuration for the release/commitlint toolchain.
# The Node dependency set exists only to run semantic-release and commitlint
# in CI; it ships no runtime code. Everything here is fail-closed.

# Never execute package lifecycle scripts (preinstall/install/postinstall).
# This is the single highest-value control: it removes arbitrary code execution
# from the install path, so a compromised transitive dependency cannot run
# during `npm ci`. Verified: no package in this tree declares these scripts,
# so nothing legitimate is lost.
ignore-scripts=true

# Refuse to build a tree with unsatisfiable peer dependencies instead of
# silently warning and installing something subtly broken.
strict-peer-deps=true

# Keep package-lock.json authoritative and always regenerate it on install.
package-lock=true

# Audit on every install and treat high/critical advisories as blocking,
# so a vulnerable release-only dependency cannot be merged unnoticed.
audit=true
audit-level=high

# Cosmetic only: drop the funding notice from CI logs.
fund=false
