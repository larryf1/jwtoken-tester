{
  "plugins": {
    "commit-analyzer": {
      "name": "default"
    },
    "ci-condition": {
      "name": "default"
    },
    "changelog-generator": {
      "name": "default",
      "options": {
        "format_commit_template": "* {{with .Scope}}**{{.}}:** {{end}}{{- .Message}} ([{{trimSHA .SHA}}](https://github.com/larryf1/jwtoken-tester/commit/{{.SHA}}))"
      }
    },
    "provider": {
      "name": "github"
    },
    "files-updater": {
      "names": []
    }
  }
}
